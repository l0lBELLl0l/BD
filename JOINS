CREATE TABLE cursos(
idCurso int PRIMARY KEY,
nome VARCHAR(30)
);

INSERT INTO cursos (idCurso, nome) VALUES ('1', 'DS');
INSERT INTO cursos (idCurso, nome) VALUES ('2', 'ADM');

select * FROM cursos;

CREATE TABLE cursos_alunos(
idRegistro INT PRIMARY KEY,
idCurso int,
rm varchar(10),
FOREIGN KEY (idCurso) REFERENCES cursos (idCurso),
FOREIGN KEY (rm) REFERENCES alunos (rm)
);

INSERT INTO cursos_alunos VALUES (1,1, '0101');
INSERT INTO cursos_alunos VALUES (2,2, '0102');

select ca.idCurso, ca.rm, c.nome nome_curso, a.nome nome_aluno from cursos_alunos ca inner join cursos c on ca.idCurso = c.idCurso inner join alunos a on ca.rm = a.rm;

